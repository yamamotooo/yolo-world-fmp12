# このファイルをコピーして .env を作り、値を入れる (cp .env.example .env)
# .env は .gitignore 済み。キーをチャットやコードに貼らないこと。

# Pokemon Price Tracker (https://www.pokemonpricetracker.com/api-keys)
POKEMON_PRICE_TRACKER_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# PokéWallet (https://pokewallet.io/dashboard)
POKEWALLET_API_KEY=
